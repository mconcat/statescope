# Copy to tests/local.env (not committed) and fill in. A test that needs a missing value FAILS; nothing is skipped silently.
# To run only what needs no private data:  pytest -m "not legacy"

# `results` folder of the original repository (calibration folders, training runs); read only
STATESCOPE_LEGACY_RESULTS=
# frozen copies of the original code; defaults <repo>/legacy_snapshot (capture test), legacy_snapshot2 (readers), legacy_snapshot3 (demonstration)
STATESCOPE_LEGACY_SNAPSHOT=
STATESCOPE_SNAPSHOT2=
STATESCOPE_SNAPSHOT3=
# CUDA device for the tests and the most memory they may take on it (GiB)
STATESCOPE_DEVICE=cuda:0
STATESCOPE_GPU_GB=12
# Hugging Face cache with the language models (offline)
STATESCOPE_HF_HOME=
# 0.8B set: the folder with L<layer>/export/ of the MLP dictionaries as trained, the folder with the two layer-9 exports in the later
# format, and the original project's path-free copy of the MLP dictionaries (L<layer>/, MANIFEST.json)
STATESCOPE_MOLT2_ROOT=
STATESCOPE_MOLT2_REEXPORTS=
STATESCOPE_MLP_COPY_08B=
# the 0.8B set laid out as published (state/L<L>/, mlp/L<L>/, MANIFEST.json; devtools/stage_release2.py makes it)
STATESCOPE_RELEASE2=
# 4B set: the folder with L<layer>/export/ of the MLP dictionaries as trained (every layer but 16), the folder with L16/export/, and the
# original project's path-free copy of the MLP dictionaries
STATESCOPE_4B_MOLT_ROOT=
STATESCOPE_4B_MOLT_L16_ROOT=
STATESCOPE_MLP_COPY_4B=
# the 4B set laid out as published (devtools/stage_release2.py --layers 32 makes it)
STATESCOPE_RELEASE_4B=
