# Copy to tests/local.env (not committed) and fill in. A test that needs a missing value FAILS; nothing is skipped silently.
# To run only what needs no private data:  pytest -m "not release and not legacy"

# folder that holds layers/Lxx/{vocab,molt}/ of the release
STATESCOPE_RELEASE_ROOT=
# `results` folder of the original repository (calibration folders, training runs); read only
STATESCOPE_LEGACY_RESULTS=
# frozen copy of the original code; default <repo>/legacy_snapshot
STATESCOPE_LEGACY_SNAPSHOT=
# CUDA device for the tests and the most memory they may take on it (GiB)
STATESCOPE_DEVICE=cuda:0
STATESCOPE_GPU_GB=12
# Hugging Face cache with the language model (offline)
STATESCOPE_HF_HOME=
# fineweb-edu as JSON lines ({"text": ...}); the spliced-loss test reads rows 131,500 on
STATESCOPE_SPLICE_CORPUS=
# short training runs (legacy vs new): device, memory cap in GiB, and optionally a lock file to queue on when the GPU is shared
STATESCOPE_TRAIN_DEVICE=cuda:0
STATESCOPE_TRAIN_GB=16
STATESCOPE_TRAIN_GPU_LOCK=
